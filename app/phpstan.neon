includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: max
    phpVersion: 80400
    paths:
        - bin
        - config
        - deptrac.php
        - src
        - tests
        - testo.php
    checkBenevolentUnionTypes: true
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    rememberPossiblyImpureFunctionValues: false
    reportIgnoresWithoutComments: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportPossiblyNonexistentGeneralArrayOffset: true
    reportUnsafeArrayStringKeyCasting: detect
    # Keep compiled analyser state outside the bind-mounted source tree so host
    # and Docker runs cannot reuse cache entries with incompatible paths.
    tmpDir: /tmp/geo-registry-phpstan
