{
    "name": "geo-registry/geo-registry",
    "description": "Non-blocking GAR/FIAS geocoder service on AMPHP",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4.12",
        "ext-json": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-pgsql": "*",
        "ext-posix": "*",
        "ext-sockets": "*",
        "ext-xmlreader": "*",
        "amphp/cache": "^2.0",
        "amphp/cluster": "^2.0",
        "amphp/http-client": "^5.3",
        "amphp/http-server": "^3.4",
        "amphp/http-server-router": "^2.0",
        "amphp/log": "^2.0",
        "amphp/postgres": "^2.2",
        "monolog/monolog": "^3.0",
        "romanfedorskij/message-bus-async": "^0.1",
        "romanfedorskij/message-bus-async-worker": "^0.1",
        "symfony/console": "^8.1",
        "symfony/validator": "^8.1",
        "thesis/dic": "^0.5.3",
        "thesis/symfony-console-module": "^0.1.0",
        "yiisoft/db-migration": "^2.2",
        "yiisoft/db-pgsql": "^2.0"
    },
    "suggest": {
        "ext-ev": "Recommended production event-loop driver.",
        "ext-pq": "Required with ext-ev for non-blocking PostgreSQL connections."
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "symfony/yaml": "^8.1",
        "testo/testo": "^0.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@phpstan",
            "@deptrac",
            "@registry:check",
            "@test"
        ],
        "cs-check": "php-cs-fixer fix --diff --dry-run --sequential --using-cache=no",
        "cs-fix": "php-cs-fixer fix --diff --sequential --using-cache=no",
        "deptrac": "deptrac --no-progress --fail-on-uncovered",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "registry:check": "bin/app message-bus:registry:check --no-interaction",
        "test": "testo --suite=Unit --suite=Scenario",
        "test:integration": "testo --suite=Integration",
        "test:contract": "testo --suite=Contract"
    }
}
