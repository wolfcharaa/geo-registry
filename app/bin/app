#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Application\DependencyInjection\CliRuntimeModule;
use App\Application\MessageBus\MessageBusRegistrySource;
use App\Application\MessageBus\MessageCodecRegistryLoader;
use App\Application\Runtime\CliRuntime;
use App\Config\EnvironmentSnapshot;
use Amp\Cluster\Cluster;
use Symfony\Component\Console\Input\ArgvInput;
use Thesis\Dic;

require dirname(__DIR__) . '/vendor/autoload.php';

/** @var list<string> $argv */
$exitCode = Dic::run(
    new CliRuntimeModule(
        EnvironmentSnapshot::capture(),
        MessageBusRegistrySource::fromFile(dirname(__DIR__) . '/config/message_bus_registry.php'),
        MessageCodecRegistryLoader::fromFile(dirname(__DIR__) . '/config/message_bus_codecs.php'),
        MessageBusRegistrySource::fromFile(dirname(__DIR__) . '/config/message_bus_http.php'),
    ),
    static fn(CliRuntime $runtime): int => $runtime->run(new ArgvInput($argv)),
);

if (Cluster::isWorker()) {
    return $exitCode;
}

exit($exitCode);
