# Secrets consumed by production Compose interpolation.
# `make deploy-init` creates config/prod.secrets.env with random database
# passwords and mode 0600. Keep this file free of non-secret runtime settings.
GEO_REGISTRY_DATABASE_PASSWORD=generate-me
GEO_REGISTRY_POSTGRES_ADMIN_PASSWORD=generate-me
GEO_REGISTRY_DATAMOS_API_KEY=
GEO_REGISTRY_OPENSEARCH_USERNAME=
GEO_REGISTRY_OPENSEARCH_PASSWORD=
