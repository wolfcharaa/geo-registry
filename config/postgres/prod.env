# PostgreSQL profile for a dedicated data server.
POSTGRES_MIN_CPU=8
POSTGRES_RECOMMENDED_CPU=16
POSTGRES_MIN_MEMORY_GB=32
POSTGRES_RECOMMENDED_MEMORY_GB=48
POSTGRES_MIN_FREE_DISK_GB=192
POSTGRES_RECOMMENDED_FREE_DISK_GB=384

POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=8GB
POSTGRES_EFFECTIVE_CACHE_SIZE=24GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=2GB
POSTGRES_AUTOVACUUM_WORK_MEM=1GB
POSTGRES_AUTOVACUUM_MAX_WORKERS=5
POSTGRES_WAL_BUFFERS=64MB
POSTGRES_MIN_WAL_SIZE=8GB
POSTGRES_MAX_WAL_SIZE=64GB
POSTGRES_WAL_COMPRESSION=on
POSTGRES_CHECKPOINT_TIMEOUT=30min
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_CHECKPOINT_WARNING=5min
POSTGRES_MAX_WORKER_PROCESSES=16
POSTGRES_MAX_PARALLEL_WORKERS=12
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=4
POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=4
POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
POSTGRES_MAINTENANCE_IO_CONCURRENCY=100
POSTGRES_HUGE_PAGES=try
POSTGRES_TRACK_IO_TIMING=on
POSTGRES_TRACK_WAL_IO_TIMING=on
POSTGRES_SHM_SIZE=8gb
