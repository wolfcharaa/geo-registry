# PostgreSQL profile for a developer workstation.
POSTGRES_MIN_CPU=2
POSTGRES_RECOMMENDED_CPU=4
POSTGRES_MIN_MEMORY_GB=4
POSTGRES_RECOMMENDED_MEMORY_GB=8
POSTGRES_MIN_FREE_DISK_GB=16
POSTGRES_RECOMMENDED_FREE_DISK_GB=32

POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_AUTOVACUUM_WORK_MEM=128MB
POSTGRES_AUTOVACUUM_MAX_WORKERS=3
POSTGRES_WAL_BUFFERS=16MB
POSTGRES_MIN_WAL_SIZE=1GB
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_WAL_COMPRESSION=on
POSTGRES_CHECKPOINT_TIMEOUT=15min
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_CHECKPOINT_WARNING=2min
POSTGRES_MAX_WORKER_PROCESSES=8
POSTGRES_MAX_PARALLEL_WORKERS=2
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=2
POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=2
POSTGRES_EFFECTIVE_IO_CONCURRENCY=32
POSTGRES_MAINTENANCE_IO_CONCURRENCY=16
POSTGRES_HUGE_PAGES=try
POSTGRES_TRACK_IO_TIMING=on
POSTGRES_TRACK_WAL_IO_TIMING=on
POSTGRES_SHM_SIZE=512mb
