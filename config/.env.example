APP_LISTEN=0.0.0.0:8080
APP_IMAGE=geo-registry-amp-app
APP_NAME=geo-registry
APP_PORT=8080
APP_USER_AGENT=geo-registry/0.1
APP_HTTP_WORKERS=1
APP_HTTP_SHUTDOWN_TIMEOUT_SECONDS=30
APP_HTTP_WORKER_MAX_REQUESTS=0
APP_HTTP_WORKER_MAX_MEMORY_MB=0
APP_HTTP_WORKER_RESTART_BURST=5
APP_HTTP_WORKER_RESTART_WINDOW_SECONDS=30
APP_HTTP_WORKER_RESTART_BACKOFF_INITIAL_SECONDS=0.5
APP_HTTP_WORKER_RESTART_BACKOFF_MAX_SECONDS=30
APP_HTTP_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
APP_HTTP_WORKER_HEARTBEAT_TIMEOUT_SECONDS=15
APP_HTTP_WORKER_STALE_TERMINATION_GRACE_SECONDS=5
APP_HTTP_CONNECTION_LIMIT=512
APP_HTTP_CONNECTIONS_PER_IP_LIMIT=64
APP_HTTP_CONCURRENCY_LIMIT=256
APP_HTTP_BACKLOG=512
APP_HTTP_COMPRESSION_ENABLED=1
HTTP_TIMEOUT_SECONDS=10
LOG_FORMAT=console
REVOLT_DRIVER=Revolt\EventLoop\Driver\UvDriver

ADDRESS_SEARCH_CACHE_ENABLED=0
ADDRESS_SEARCH_CACHE_MAX_ENTRIES=512
ADDRESS_SEARCH_CACHE_TTL_SECONDS=60
ADDRESS_SEARCH_CACHE_EMPTY_TTL_SECONDS=5
ADDRESS_SEARCH_CACHE_NAMESPACE=v1

ADDRESS_SOURCE_DATA_PATH=../../../docker/data
DATAMOS_ADDRESS_REGISTRY_SOURCE=/data/datamos/addressreestr.jsonl.gz
OSM_ADDRESS_ALIASES_SOURCE=/data/geodata/moscow-address-aliases.jsonl
MOSCOW_REGION_CODE=77

DATABASE_DSN=host=postgres port=5432 user=app password=local-app-only db=app application_name=geo-registry
HTTP_DATABASE_POOL_SIZE=4
WORKER_DATABASE_POOL_SIZE=4
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=local-app-only
POSTGRES_PORT=5432
POSTGRES_TUNING_PROFILE=dev

NOMINATIM_URL=http://nominatim:8080
NOMINATIM_PORT=8081
NOMINATIM_LANGUAGE=ru
NOMINATIM_ENABLED=1
NOMINATIM_PBF_URL=https://download.geofabrik.de/europe/monaco-latest.osm.pbf
# NOMINATIM_DATA_PATH is mounted read-only at /data/nominatim inside the container.
NOMINATIM_PBF_PATH=
NOMINATIM_DATA_PATH=../../../docker/data/nominatim
NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/europe/monaco-updates/
NOMINATIM_IMPORT_STYLE=address
NOMINATIM_UPDATE_MODE=none
NOMINATIM_PASSWORD=local-nominatim-only
NOMINATIM_THREADS=2

OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=places
OPENSEARCH_ENABLED=1
OPENSEARCH_SEARCH_ENABLED=0
OPENSEARCH_COORDINATE_UPDATES_ENABLED=0
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT_SECONDS=60
OPENSEARCH_NUMBER_OF_SHARDS=1
OPENSEARCH_NUMBER_OF_REPLICAS=0
OPENSEARCH_BULK_NUMBER_OF_REPLICAS=0
OPENSEARCH_REFRESH_INTERVAL=1s
OPENSEARCH_BULK_REFRESH_INTERVAL=-1
OPENSEARCH_REINDEX_MEMORY_LIMIT=512M
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
