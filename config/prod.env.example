# Runtime configuration for the immutable production application image.
# Copy to the ignored config/prod.env and replace every placeholder.
DOCKER_IMAGE_PREFIX=registry.example/namespace/geo-registry

APP_NAME=geo-registry
APP_USER_AGENT=geo-registry/0.1
APP_HTTP_WORKERS=2
APP_HTTP_SHUTDOWN_TIMEOUT_SECONDS=30
APP_HTTP_WORKER_MAX_REQUESTS=10000
APP_HTTP_WORKER_MAX_MEMORY_MB=256
APP_HTTP_WORKER_RESTART_BURST=5
APP_HTTP_WORKER_RESTART_WINDOW_SECONDS=30
APP_HTTP_WORKER_RESTART_BACKOFF_INITIAL_SECONDS=0.5
APP_HTTP_WORKER_RESTART_BACKOFF_MAX_SECONDS=30
APP_HTTP_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
APP_HTTP_WORKER_HEARTBEAT_TIMEOUT_SECONDS=15
APP_HTTP_CONNECTION_LIMIT=1024
APP_HTTP_CONNECTIONS_PER_IP_LIMIT=0
APP_HTTP_CONCURRENCY_LIMIT=512
APP_HTTP_BACKLOG=1024
APP_HTTP_COMPRESSION_ENABLED=1
HTTP_TIMEOUT_SECONDS=10
LOG_FORMAT=json
REVOLT_DRIVER=Revolt\EventLoop\Driver\UvDriver

ADDRESS_SEARCH_CACHE_ENABLED=1
ADDRESS_SEARCH_CACHE_MAX_ENTRIES=512
ADDRESS_SEARCH_CACHE_TTL_SECONDS=60
ADDRESS_SEARCH_CACHE_EMPTY_TTL_SECONDS=5
ADDRESS_SEARCH_CACHE_NAMESPACE=v1

DATABASE_DSN=host=database.example port=5432 user=geo_registry password=replace-me db=geo_registry application_name=geo-registry
HTTP_DATABASE_POOL_SIZE=4
WORKER_DATABASE_POOL_SIZE=4

NOMINATIM_ENABLED=1
NOMINATIM_URL=http://nominatim.example:8080
NOMINATIM_LANGUAGE=ru

OPENSEARCH_ENABLED=1
OPENSEARCH_URL=http://opensearch.example:9200
OPENSEARCH_INDEX=places
OPENSEARCH_SEARCH_ENABLED=1
OPENSEARCH_COORDINATE_UPDATES_ENABLED=1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT_SECONDS=10
OPENSEARCH_NUMBER_OF_SHARDS=1
OPENSEARCH_NUMBER_OF_REPLICAS=0
OPENSEARCH_BULK_NUMBER_OF_REPLICAS=0
OPENSEARCH_REFRESH_INTERVAL=1s
OPENSEARCH_BULK_REFRESH_INTERVAL=-1
OPENSEARCH_REINDEX_MEMORY_LIMIT=512M

APP_BIND_HOST=127.0.0.1
APP_PORT=8080
APP_MEMORY_LIMIT=1g
APP_CPUS=2
APP_PIDS_LIMIT=256
APP_HEALTH_INTERVAL=10s
APP_HEALTH_TIMEOUT=3s
APP_HEALTH_RETRIES=12
APP_HEALTH_START_PERIOD=30s
APP_STOP_GRACE_PERIOD=40s

WORKER_ADDRESS_MEMORY_LIMIT=1g
WORKER_ADDRESS_CPUS=2
WORKER_ADDRESS_PIDS_LIMIT=256
WORKER_RUNTIME_MEMORY_LIMIT=1g
WORKER_RUNTIME_CPUS=2
WORKER_RUNTIME_PIDS_LIMIT=256
WORKER_STOP_GRACE_PERIOD=60s

LOG_MAX_FILES=5
LOG_MAX_SIZE=20m
