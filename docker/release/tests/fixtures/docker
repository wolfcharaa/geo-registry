#!/bin/sh
set -eu

state_file=${FAKE_DOCKER_STATE:?Set FAKE_DOCKER_STATE}
command_name=${1:-}
[ "$#" -gt 0 ] && shift

case "${command_name}" in
    image)
        action=${1:-}
        [ "$#" -gt 0 ] && shift
        [ "${action}" = inspect ] || exit 64

        format=
        if [ "${1:-}" = --format ]; then
            format=$2
            shift 2
        fi
        image=${1:-}

        case "${image}" in
            *@sha256:*)
                [ "${FAKE_DOCKER_EXACT_LOADED:-0}" = 1 ] || exit 1
                ;;
            *)
                [ "${FAKE_DOCKER_EXACT_LOADED:-0}" = 1 ] || [ -f "${state_file}" ] || exit 1
                ;;
        esac

        case "${format}" in
            '') ;;
            '{{range .RepoDigests}}{{println .}}{{end}}') printf '%s\n' "${FAKE_DOCKER_EXACT_IMAGE:-}" ;;
            '{{.Os}}/{{.Architecture}}') printf '%s\n' 'linux/amd64' ;;
            '{{index .Config.Labels "org.opencontainers.image.version"}}') printf '%s\n' 'v0.2.0' ;;
            *) exit 65 ;;
        esac
        ;;
    load)
        : >"${state_file}"
        printf '%s\n' 'Loaded image: ghcr.io/wolfcharaa/geo-registry/app:v0.2.0-linux-amd64'
        ;;
    run|compose)
        ;;
    *)
        exit 64
        ;;
esac
