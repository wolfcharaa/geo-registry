#!/bin/sh
set -eu

state_file=${FAKE_DOCKER_STATE:?Set FAKE_DOCKER_STATE}
command_name=${1:-}
[ "$#" -gt 0 ] && shift

if [ -n "${FAKE_DOCKER_LOG:-}" ]; then
    {
        printf '%s' "${command_name}"
        for argument in "$@"; do
            printf ' %s' "${argument}"
        done
        printf '\n'
    } >>"${FAKE_DOCKER_LOG}"
fi

case "${command_name}" in
    image)
        action=${1:-}
        [ "$#" -gt 0 ] && shift
        [ "${action}" = inspect ] || exit 64

        format=
        if [ "${1:-}" = --format ]; then
            format=$2
            shift 2
        fi
        image=${1:-}

        case "${image}" in
            *@sha256:*)
                [ "${FAKE_DOCKER_EXACT_LOADED:-0}" = 1 ] || exit 1
                ;;
            *)
                [ "${FAKE_DOCKER_EXACT_LOADED:-0}" = 1 ] || [ -f "${state_file}" ] || exit 1
                ;;
        esac

        case "${format}" in
            '') ;;
            '{{range .RepoDigests}}{{println .}}{{end}}') printf '%s\n' "${FAKE_DOCKER_EXACT_IMAGE:-}" ;;
            '{{index .RepoDigests 0}}') printf '%s\n' "${FAKE_DOCKER_EXACT_IMAGE:-}" ;;
            '{{.Os}}/{{.Architecture}}') printf '%s\n' "${FAKE_DOCKER_PLATFORM:-linux/amd64}" ;;
            '{{.Id}}') printf '%s\n' "${FAKE_DOCKER_IMAGE_ID:-sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}" ;;
            '{{index .Config.Labels "org.opencontainers.image.version"}}') printf '%s\n' "${FAKE_DOCKER_VERSION:-v0.2.0}" ;;
            '{{index .Config.Labels "org.opencontainers.image.revision"}}') printf '%s\n' "${FAKE_DOCKER_SOURCE_REVISION:-}" ;;
            '{{index .Config.Labels "org.geo-registry.message-bus-core.revision"}}') printf '%s\n' "${FAKE_DOCKER_CORE_REVISION:-}" ;;
            '{{index .Config.Labels "org.geo-registry.message-bus-worker.revision"}}') printf '%s\n' "${FAKE_DOCKER_WORKER_REVISION:-}" ;;
            *) exit 65 ;;
        esac
        ;;
    load)
        : >"${state_file}"
        printf '%s\n' 'Loaded image: ghcr.io/wolfcharaa/geo-registry/app:v0.2.0-linux-amd64'
        ;;
    pull)
        : >"${state_file}"
        ;;
    push)
        printf 'Pushed image: %s\n' "${1:-}"
        ;;
    save)
        [ "${1:-}" = --output ] || exit 64
        printf '%s\n' 'fake-docker-image-archive' >"${2:?}"
        ;;
    buildx)
        case "${1:-}" in
            version)
                printf '%s\n' 'github.com/docker/buildx v0.37.1 test'
                ;;
            build)
                if [ "${2:-}" = --help ]; then
                    printf '%s\n' '      --load              Shorthand for --output=type=docker'
                    printf '%s\n' '      --platform string   Set target platform'
                elif [ "${FAKE_DOCKER_BUILDX_BUILD_SUPPORTED:-0}" != 1 ]; then
                    exit 64
                fi
                ;;
            imagetools)
                [ "${2:-}" = inspect ] || exit 64
                if [ "${3:-}" = --help ]; then
                    if [ "${FAKE_DOCKER_BUILDX_FORMAT_SUPPORTED:-1}" = 1 ]; then
                        printf '%s\n' '      --format string   Format the output'
                    fi
                    exit 0
                fi
                [ "${3:-}" = --format ] || exit 64
                [ "${4:-}" = '{{.Manifest.Digest}}' ] || exit 65
                case "${5:-}" in
                    *@sha256:*) printf '%s\n' "${FAKE_DOCKER_REMOTE_EXACT_DIGEST:-${FAKE_DOCKER_REMOTE_DIGEST:-sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}}" ;;
                    *) printf '%s\n' "${FAKE_DOCKER_REMOTE_DIGEST:-sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}" ;;
                esac
                ;;
            *)
                exit 64
                ;;
        esac
        ;;
    inspect)
        if [ "${1:-}" = --format ]; then
            case "${2:-}" in
                '{{.State.Running}}') printf '%s\n' "${FAKE_DOCKER_CONTAINER_RUNNING:-true}" ;;
                '{{.Config.Image}}') printf '%s\n' 'postgis:17-test' ;;
                '{{.Id}}') printf '%s\n' 'sha256:postgres-test' ;;
                '{{.Name}}') printf '/%s\n' "${FAKE_DOCKER_POSTGRES_CONTAINER:-geo-registry-postgres-test}" ;;
                *) exit 65 ;;
            esac
        fi
        ;;
    port)
        printf '%s\n' "${FAKE_DOCKER_PORT_BINDINGS:-}"
        ;;
    ps)
        printf '%s\n' "${FAKE_DOCKER_PORT_OWNERS:-}"
        ;;
    exec)
        case " $* " in
            *' pg_restore --list '*) ;;
            *' pg_restore --no-password '*)
                sleep "${FAKE_DOCKER_RESTORE_SLEEP_SECONDS:-0}"
                ;;
            *' createdb --no-password '*)
                if [ -n "${FAKE_DOCKER_DATABASE_STATE:-}" ]; then
                    : >"${FAKE_DOCKER_DATABASE_STATE}"
                fi
                ;;
            *' pg_dump --version '*) printf '%s\n' 'pg_dump (PostgreSQL) 17.6' ;;
            *' pg_dump --no-password '*)
                sleep "${FAKE_DOCKER_DUMP_SLEEP_SECONDS:-0}"
                printf '%s\n' 'fake-pgdump-archive'
                ;;
            *'pg_size_pretty(pg_database_size(d.oid))'*)
                printf '%s|%s|%s\n' \
                    "${FAKE_DOCKER_DATABASE_SIZE:-77 GB}" \
                    "${FAKE_DOCKER_DATABASE_OWNER:-geo_registry}" \
                    "${FAKE_DOCKER_ACTIVE_RESTORES:-0}"
                ;;
            *application_name*pg_restore*)
                case " $* " in
                    *'SELECT count(*)'*) printf '%s\n' "${FAKE_DOCKER_ACTIVE_RESTORES:-0}" ;;
                    *) printf '%s\n' 'state=active wait=IO/DataFileRead current_seconds=1 sql=CREATE INDEX' ;;
                esac
                ;;
            *application_name*pg_dump*)
                printf '%s\n' 'state=active wait=Client/ClientWrite current_seconds=1'
                ;;
            *'NOT indisvalid OR NOT indisready'*)
                printf '%s\n' "${FAKE_DOCKER_INTEGRITY_SUMMARY:-83|0|0}"
                ;;
            *'pg_size_pretty(pg_database_size(current_database()))'*)
                printf '%s\n' "${FAKE_DOCKER_RESTORE_DATABASE_SUMMARY:-1 MB relations=4}"
                ;;
            *'rolsuper::int'*) printf '%s\n' "${FAKE_DOCKER_ROLE_SUMMARY:-0|0|0|0}" ;;
            *' SELECT current_database(); '*) printf '%s\n' "${FAKE_DOCKER_DATABASE_NAME:-geo_registry}" ;;
            *' SELECT pg_database_size(current_database()); '*) printf '%s\n' 1048576 ;;
            *' SHOW server_version; '*) printf '%s\n' 17.6 ;;
            *' SHOW server_version_num; '*) printf '%s\n' 170006 ;;
            *'SELECT count(*) FROM pg_database'*)
                if [ -n "${FAKE_DOCKER_DATABASE_STATE:-}" ] && [ -f "${FAKE_DOCKER_DATABASE_STATE}" ]; then
                    printf '%s\n' 1
                else
                    printf '%s\n' "${FAKE_DOCKER_DATABASE_EXISTS:-1}"
                fi
                ;;
            *' FROM pg_roles '*) printf '%s\n' 1 ;;
        esac
        ;;
    compose)
        compose_command=
        compose_service=
        for argument in "$@"; do
            case "${argument}" in
                config|ps|run|stop|up) compose_command=${argument} ;;
                app|postgres) compose_service=${argument} ;;
            esac
        done
        case "${compose_command}" in
            config)
                if [ -n "${FAKE_DOCKER_COMPOSE_CONFIG_FILE:-}" ]; then
                    cat "${FAKE_DOCKER_COMPOSE_CONFIG_FILE}"
                fi
                ;;
            ps)
                case "${compose_service}" in
                    app) printf '%s\n' "${FAKE_DOCKER_APP_CONTAINER:-}" ;;
                    *) printf '%s\n' "${FAKE_DOCKER_POSTGRES_CONTAINER:-geo-registry-postgres-test}" ;;
                esac
                ;;
        esac
        ;;
    run)
        ;;
    *)
        exit 64
        ;;
esac
