                {
                    "name": "Ready",
                    "description": "OpenAPI operationId: getHealthReady\nMigration status: current.",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Readiness follows dependency policy', function () {",
                                    "    pm.expect([200, 503]).to.include(pm.response.code);",
                                    "    const body = pm.response.json();",
                                    "    pm.expect(['ok', 'degraded', 'unavailable']).to.include(body.status);",
                                    "    pm.expect(body.components).to.be.an('array');",
                                    "    body.components.forEach(function (component) {",
                                    "        pm.expect(component).to.have.all.keys('name', 'policy', 'status');",
                                    "    });",
                                    "    if (body.status === 'unavailable') { pm.response.to.have.status(503); }",
                                    "    if (body.status !== 'unavailable') { pm.response.to.have.status(200); }",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/health/ready"
                    },
                    "response": [
                        {
                            "name": "200 Degraded",
                            "originalRequest": {"method": "GET", "header": [], "url": "{{baseUrl}}/health/ready"},
                            "status": "OK",
                            "code": 200,
                            "_postman_previewlanguage": "json",
                            "header": [{"key": "Content-Type", "value": "application/json"}],
                            "cookie": [],
                            "body": "{\n  \"status\": \"degraded\",\n  \"components\": [\n    {\"name\": \"postgres\", \"policy\": \"required\", \"status\": \"ok\"},\n    {\"name\": \"nominatim\", \"policy\": \"optional\", \"status\": \"unavailable\"},\n    {\"name\": \"opensearch\", \"policy\": \"optional\", \"status\": \"ok\"}\n  ]\n}"
                        },
